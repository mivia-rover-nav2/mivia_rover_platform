<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ros2_control integration for Mivia Rover
    - 4 independently driven wheel joints
    - velocity command interface
    - position/velocity state interfaces
  -->

  <xacro:macro name="mivia_rover_ros2_control" params="name prefix use_mock_hardware">

    <ros2_control name="${name}" type="system">

      <!-- Real (custom) hardware plugin -->
      <xacro:unless value="${use_mock_hardware}">
        <hardware>
          <plugin>mivia_rover_platform/MiviaRoverSystem</plugin>
          <!-- Optional parameters for your SystemInterface (add only if used in code)
          <param name="example_param_hw_start_duration_sec">0</param>
          <param name="example_param_hw_stop_duration_sec">0</param>
          -->
        </hardware>
      </xacro:unless>

      <!-- Mock hardware plugin (useful for fast validation) -->
      <xacro:if value="${use_mock_hardware}">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </hardware>
      </xacro:if>

      <!-- Wheel joints -->
      <joint name="${prefix}wheel_fl_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}wheel_fr_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}wheel_rl_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}wheel_rr_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>