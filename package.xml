<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mivia_rover_platform</name>
  <version>0.0.0</version>
  <description>ROS 2 package providing ros2_control integration for the Mivia Rover platform (4 independently driven wheels).</description>

  <maintainer email="aguarini@unisa.it">Alessio Guarini</maintainer>
  <author email="aguarini@unisa.it">Alessio Guarini</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core: hardware plugin deps (build + run) -->
  <depend>backward_ros</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- Runtime: can_msgs -->
  <exec_depend>mivia_rover_can_msgs</exec_depend>

  <!-- Runtime: controller manager / controllers -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>

  <!-- Runtime: robot description / visualization (keep if this package truly provides them) -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Optional: navigation stack (keep only if your platform package really owns Nav2 launch/params) -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>navigation2</exec_depend>

  <!-- Tests (recommended if you add plugin load test) -->
  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>hardware_interface</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>