<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mivia_rover_platform</name>
  <version>0.0.0</version>
  <description>ROS 2 package providing ros2_control integration for the Mivia Rover platform (4 independently driven wheels).</description>

  <!-- Maintainers -->
  <maintainer email="aguarini@unisa.it">Alessio Guarini</maintainer>

  <license>Apache-2.0</license>

  <!-- Authors (optional but recommended) -->
  <author email="aguarini@unisa.it">Alessio Guarini</author>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build-time + runtime dependencies for the hardware plugin -->
  <depend>backward_ros</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- Runtime bringup dependencies -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>

  <!-- Controller used in the first bringup (velocity commands for multiple wheel joints) -->
  <exec_depend>forward_command_controller</exec_depend>

  <!-- Robot model / visualization -->
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Tests (optional but aligned with demo structure) -->
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>liburdfdom-tools</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>